# ElevenLabs API key (server-only). Used by /api/elevenlabs/signed-url and
# scripts/elevenlabs-sync.ts. Never expose it to the client.
ELEVENLABS_API_KEY=

# The agent to run. Create/update it with `npm run elevenlabs:sync`.
ELEVENLABS_AGENT_ID=

# Optional: voice used when creating/updating the agent.
ELEVENLABS_VOICE_ID=

# Optional: Supabase project "Subirachs Ventures" (schema `heylola_eleven`).
# Server-only; used by /api/session to store anonymous session stats, handover
# leads and (only when the visitor opts in) transcripts. Never NEXT_PUBLIC_.
# Leave empty to disable storage.
SUPABASE_URL=https://dhvwycxkkbqzvmrkysym.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
